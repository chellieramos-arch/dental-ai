# Per-school environment — copy to .env.<school_id> and fill in.
# Example: .env.ufl for University of Florida
# Used by: bash provision_school.sh <school_id>

# ── School identity (shown in the app UI) ─────────────────────────────────────
SCHOOL_NAME="UF College of Dentistry"
SCHOOL_NAME_ES=""                      # optional Spanish name; defaults to SCHOOL_NAME
SCHOOL_SHORT="UF"                      # short badge label; defaults to uppercased school_id
UNIVERSITY_NAME="University of Florida"
PROGRAM_LABEL="Student Study Portal"

# ── Login restriction ──────────────────────────────────────────────────────────
ALLOWED_EMAIL_DOMAINS="@ufl.edu,@dental.ufl.edu"
EMAIL_PLACEHOLDER=""                   # optional; defaults to yourname@<first domain>

# ── Branding asset (optional) ──────────────────────────────────────────────────
SEAL_FILE=""                           # e.g. ufl_seal.png — add the file to the repo root

# ── This school's OWN backend (create these first — full isolation) ────────────
SUPABASE_URL="https://<their-project>.supabase.co"
SUPABASE_KEY="<their service key>"
PINECONE_INDEX="dentai-ufl"
ADMIN_PASSWORD=""                      # leave blank to set later; faculty dashboard login

# ── Shared API keys (same as your main .env unless the school pays their own) ──
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
PINECONE_API_KEY=""
